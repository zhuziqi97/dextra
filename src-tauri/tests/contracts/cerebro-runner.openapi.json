  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": { "$ref": "#/components/schemas/ValidationError" },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ListData_RunnerResponse_": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "description": "数据项列表",
            "items": { "$ref": "#/components/schemas/RunnerResponse" },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "description": "当前页码",
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "description": "每页条数",
            "title": "Page Size",
            "type": "integer"
          },
          "total": {
            "description": "总记录数",
            "title": "Total",
            "type": "integer"
          },
          "total_pages": {
            "description": "总页数",
            "title": "Total Pages",
            "type": "integer"
          }
        },
        "required": ["items", "total", "page", "page_size", "total_pages"],
        "title": "ListData[RunnerResponse]",
        "type": "object"
      },
      "ListResponse_RunnerResponse_": {
        "additionalProperties": false,
        "properties": {
          "data": { "$ref": "#/components/schemas/ListData_RunnerResponse_" },
          "success": { "const": true, "title": "Success", "type": "boolean" }
        },
        "required": ["success", "data"],
        "title": "ListResponse[RunnerResponse]",
        "type": "object"
      },
      "RunnerListRequest": {
        "additionalProperties": false,
        "description": "当前 owner 的 Runner 分页查询。",
        "properties": {
          "page": {
            "default": 1,
            "minimum": 1,
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "title": "Page Size",
            "type": "integer"
          },
          "status": {
            "anyOf": [
              {
                "enum": ["REGISTERED", "OFFLINE", "ONLINE", "REVOKED"],
                "type": "string"
              },
              { "type": "null" }
            ],
            "title": "Status"
          }
        },
        "title": "RunnerListRequest",
        "type": "object"
      },
      "RunnerMCPPrincipalResponse": {
        "additionalProperties": false,
        "description": "单次 Agent 启动使用的 Cerebro MCP HTTP 配置。",
        "properties": {
          "access_token": { "title": "Access Token", "type": "string" },
          "expires_in": { "title": "Expires In", "type": "integer" },
          "mcp_url": { "title": "Mcp Url", "type": "string" },
          "token_type": {
            "const": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": ["mcp_url", "access_token", "token_type", "expires_in"],
        "title": "RunnerMCPPrincipalResponse",
        "type": "object"
      },
      "RunnerMCPSessionCreateRequest": {
        "additionalProperties": false,
        "description": "Runner 为一个本地 Agent 会话领取短期 MCP principal。",
        "properties": {
          "binding_id": {
            "format": "uuid",
            "title": "Binding Id",
            "type": "string"
          },
          "session_id": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": ["binding_id", "session_id"],
        "title": "RunnerMCPSessionCreateRequest",
        "type": "object"
      },
      "RunnerMCPTaskCreateRequest": {
        "additionalProperties": false,
        "description": "Runner 为已投递 Task 领取短期 MCP principal。",
        "properties": {
          "task_id": { "format": "uuid", "title": "Task Id", "type": "string" }
        },
        "required": ["task_id"],
        "title": "RunnerMCPTaskCreateRequest",
        "type": "object"
      },
      "RunnerPairingApproveRequest": {
        "additionalProperties": false,
        "description": "当前浏览器用户批准设备配对。",
        "properties": {
          "runner_display_name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Runner Display Name",
            "type": "string"
          },
          "user_code": {
            "maxLength": 16,
            "minLength": 3,
            "title": "User Code",
            "type": "string"
          }
        },
        "required": ["user_code", "runner_display_name"],
        "title": "RunnerPairingApproveRequest",
        "type": "object"
      },
      "RunnerPairingApproveResponse": {
        "additionalProperties": false,
        "description": "配对批准结果。",
        "properties": {
          "display_name": { "title": "Display Name", "type": "string" },
          "runner_id": { "title": "Runner Id", "type": "string" }
        },
        "required": ["runner_id", "display_name"],
        "title": "RunnerPairingApproveResponse",
        "type": "object"
      },
      "RunnerPairingCreateRequest": {
        "additionalProperties": false,
        "description": "创建设备配对流程。",
        "properties": {},
        "title": "RunnerPairingCreateRequest",
        "type": "object"
      },
      "RunnerPairingCreateResponse": {
        "additionalProperties": false,
        "description": "Dextra device flow 参数。",
        "properties": {
          "device_code": { "title": "Device Code", "type": "string" },
          "expires_in": { "title": "Expires In", "type": "integer" },
          "interval": { "title": "Interval", "type": "integer" },
          "user_code": { "title": "User Code", "type": "string" },
          "verification_uri": { "title": "Verification Uri", "type": "string" }
        },
        "required": [
          "device_code",
          "user_code",
          "verification_uri",
          "expires_in",
          "interval"
        ],
        "title": "RunnerPairingCreateResponse",
        "type": "object"
      },
      "RunnerPairingExchangeRequest": {
        "additionalProperties": false,
        "description": "Dextra 领取配对结果。",
        "properties": {
          "device_code": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Device Code",
            "type": "string"
          }
        },
        "required": ["device_code"],
        "title": "RunnerPairingExchangeRequest",
        "type": "object"
      },
      "RunnerPairingExchangeResponse": {
        "additionalProperties": false,
        "description": "一次性返回设备 refresh credential。",
        "properties": {
          "refresh_credential": {
            "title": "Refresh Credential",
            "type": "string"
          },
          "runner_id": { "title": "Runner Id", "type": "string" }
        },
        "required": ["runner_id", "refresh_credential"],
        "title": "RunnerPairingExchangeResponse",
        "type": "object"
      },
      "RunnerResponse": {
        "additionalProperties": false,
        "description": "不含凭据的 Runner 公开摘要。",
        "properties": {
          "codeg_version": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Codeg Version"
          },
          "created_at": { "title": "Created At", "type": "string" },
          "dextra_build": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Dextra Build"
          },
          "display_name": { "title": "Display Name", "type": "string" },
          "last_seen_at": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Last Seen At"
          },
          "runner_id": { "title": "Runner Id", "type": "string" },
          "status": {
            "enum": ["REGISTERED", "OFFLINE", "ONLINE", "REVOKED"],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "runner_id",
          "display_name",
          "status",
          "last_seen_at",
          "dextra_build",
          "codeg_version",
          "created_at"
        ],
        "title": "RunnerResponse",
        "type": "object"
      },
      "RunnerRevokeRequest": {
        "additionalProperties": false,
        "description": "撤销当前 owner 的 Runner。",
        "properties": {
          "client_request_id": {
            "format": "uuid",
            "title": "Client Request Id",
            "type": "string"
          },
          "runner_id": {
            "format": "uuid",
            "title": "Runner Id",
            "type": "string"
          }
        },
        "required": ["client_request_id", "runner_id"],
        "title": "RunnerRevokeRequest",
        "type": "object"
      },
      "RunnerTargetBindingQueryRequest": {
        "additionalProperties": false,
        "description": "Runner 查询本人的唯一目录绑定。",
        "properties": {
          "target_id": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Target Id",
            "type": "string"
          }
        },
        "required": ["target_id"],
        "title": "RunnerTargetBindingQueryRequest",
        "type": "object"
      },
      "RunnerTargetBindingQueryResponse": {
        "additionalProperties": false,
        "description": "查询成功但目录未绑定时，binding 明确为空。",
        "properties": {
          "binding": {
            "anyOf": [
              { "$ref": "#/components/schemas/RunnerTargetBindingResponse" },
              { "type": "null" }
            ]
          }
        },
        "required": ["binding"],
        "title": "RunnerTargetBindingQueryResponse",
        "type": "object"
      },
      "RunnerTargetBindingResponse": {
        "additionalProperties": false,
        "description": "目录绑定的模块展示信息与不可用原因，不含凭据。",
        "properties": {
          "binding_id": { "title": "Binding Id", "type": "string" },
          "module_display_name": {
            "title": "Module Display Name",
            "type": "string"
          },
          "module_path": { "title": "Module Path", "type": "string" },
          "status": {
            "enum": ["ACTIVE", "DISABLED"],
            "title": "Status",
            "type": "string"
          },
          "unavailable_code": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Unavailable Code"
          },
          "unavailable_message": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Unavailable Message"
          }
        },
        "required": [
          "binding_id",
          "module_path",
          "module_display_name",
          "status",
          "unavailable_code",
          "unavailable_message"
        ],
        "title": "RunnerTargetBindingResponse",
        "type": "object"
      },
      "RunnerTokenRefreshRequest": {
        "additionalProperties": false,
        "description": "Runner 使用 refresh credential 换取 access token。",
        "properties": {
          "refresh_credential": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Refresh Credential",
            "type": "string"
          }
        },
        "required": ["refresh_credential"],
        "title": "RunnerTokenRefreshRequest",
        "type": "object"
      },
      "RunnerTokenResponse": {
        "additionalProperties": false,
        "description": "Runner 短期 access token。",
        "properties": {
          "access_token": { "title": "Access Token", "type": "string" },
          "expires_in": { "title": "Expires In", "type": "integer" },
          "token_type": {
            "const": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": ["access_token", "token_type", "expires_in"],
        "title": "RunnerTokenResponse",
        "type": "object"
      },
      "SuccessResponse_RunnerMCPPrincipalResponse_": {
        "additionalProperties": false,
        "properties": {
          "data": { "$ref": "#/components/schemas/RunnerMCPPrincipalResponse" },
          "success": { "const": true, "title": "Success", "type": "boolean" }
        },
        "required": ["success", "data"],
        "title": "SuccessResponse[RunnerMCPPrincipalResponse]",
        "type": "object"
      },
      "SuccessResponse_RunnerPairingApproveResponse_": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/RunnerPairingApproveResponse"
          },
          "success": { "const": true, "title": "Success", "type": "boolean" }
        },
        "required": ["success", "data"],
