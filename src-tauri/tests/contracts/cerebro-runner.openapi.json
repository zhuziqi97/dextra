              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Runner Mcp Task Principal",
        "tags": ["Dextra执行端"]
      }
    },
    "/api/v1/execution-runner-tokens/refresh": {
      "post": {
        "description": "使用设备 refresh credential 签发短期 access token。",
