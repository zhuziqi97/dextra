              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Runner Pairing",
        "tags": ["Dextra执行端"]
      }
    },
    "/api/v1/execution-runner-pairings/exchange": {
      "post": {
        "description": "让 Dextra 一次性领取 refresh credential。",
        "operationId": "exchange_runner_pairing_api_v1_execution_runner_pairings_exchange_post",
