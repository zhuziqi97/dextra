          }
        },
        "summary": "Exchange Runner Pairing",
        "tags": ["Dextra执行端"]
      }
    },
    "/api/v1/execution-runner-tokens/refresh": {
      "post": {
        "description": "使用设备 refresh credential 签发短期 access token。",
        "operationId": "refresh_runner_token_api_v1_execution_runner_tokens_refresh_post",
        "requestBody": {
