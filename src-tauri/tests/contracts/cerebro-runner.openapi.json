  },
  "components": {
    "schemas": {
      "ClientConfigurationQueryRequest": {
        "additionalProperties": false,
        "description": "选择本人客户端中的目录。",
        "properties": {
          "target_id": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Target Id",
            "type": "string"
          }
        },
        "required": ["target_id"],
        "title": "ClientConfigurationQueryRequest",
        "type": "object"
      },
      "ClientConfigurationResponse": {
        "additionalProperties": false,
        "description": "两端均展示服务端返回的实际配置。",
        "properties": {
          "binding_id": {
            "anyOf": [
              { "format": "uuid", "type": "string" },
              { "type": "null" }
            ],
            "title": "Binding Id"
          },
          "credential_expires_at": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Credential Expires At"
          },
          "execution_module_id": {
            "anyOf": [
              { "format": "uuid", "type": "string" },
              { "type": "null" }
            ],
            "title": "Execution Module Id"
          },
          "grant_id": {
            "anyOf": [
              { "format": "uuid", "type": "string" },
              { "type": "null" }
            ],
            "title": "Grant Id"
          },
          "mcp_enabled": { "title": "Mcp Enabled", "type": "boolean" },
          "mcp_module_ids": {
            "items": { "format": "uuid", "type": "string" },
            "title": "Mcp Module Ids",
            "type": "array"
          },
          "module_labels": {
            "additionalProperties": { "type": "string" },
            "title": "Module Labels",
            "type": "object"
          },
          "runner_id": {
            "format": "uuid",
            "title": "Runner Id",
            "type": "string"
          },
          "target_id": { "title": "Target Id", "type": "string" }
        },
        "required": [
          "runner_id",
          "target_id",
          "execution_module_id",
          "binding_id",
          "mcp_module_ids",
          "mcp_enabled",
          "module_labels",
          "grant_id",
          "credential_expires_at"
        ],
        "title": "ClientConfigurationResponse",
        "type": "object"
      },
      "ClientConfigurationSaveRequest": {
        "additionalProperties": false,
        "description": "保存整份配置，普通编辑采用后写入胜出。",
        "properties": {
          "execution_module_id": {
            "anyOf": [
              { "format": "uuid", "type": "string" },
              { "type": "null" }
            ],
            "title": "Execution Module Id"
          },
          "mcp_enabled": { "title": "Mcp Enabled", "type": "boolean" },
          "mcp_module_ids": {
            "items": { "format": "uuid", "type": "string" },
            "maxItems": 100,
            "title": "Mcp Module Ids",
            "type": "array"
          },
          "target_id": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Target Id",
            "type": "string"
          }
        },
        "required": [
          "target_id",
          "execution_module_id",
          "mcp_module_ids",
          "mcp_enabled"
        ],
        "title": "ClientConfigurationSaveRequest",
        "type": "object"
      },
      "ClientCredentialRequest": {
        "additionalProperties": false,
        "description": "显式查看或重新生成凭证。",
        "properties": {
          "rotate": { "default": false, "title": "Rotate", "type": "boolean" },
          "target_id": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Target Id",
            "type": "string"
          }
        },
        "required": ["target_id"],
        "title": "ClientCredentialRequest",
        "type": "object"
      },
      "ClientCredentialResponse": {
        "additionalProperties": false,
        "description": "当前短期 MCP 连接凭证。",
        "properties": {
          "access_token": { "title": "Access Token", "type": "string" },
          "expires_at": { "title": "Expires At", "type": "string" },
          "mcp_url": { "title": "Mcp Url", "type": "string" }
        },
        "required": ["mcp_url", "access_token", "expires_at"],
        "title": "ClientCredentialResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": { "$ref": "#/components/schemas/ValidationError" },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ListData_ProjectResponse_": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "description": "数据项列表",
            "items": { "$ref": "#/components/schemas/ProjectResponse" },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "description": "当前页码",
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "description": "每页条数",
            "title": "Page Size",
            "type": "integer"
          },
          "total": {
            "description": "总记录数",
            "title": "Total",
            "type": "integer"
          },
          "total_pages": {
            "description": "总页数",
            "title": "Total Pages",
            "type": "integer"
          }
        },
        "required": ["items", "total", "page", "page_size", "total_pages"],
        "title": "ListData[ProjectResponse]",
        "type": "object"
      },
      "ListData_RunnerResponse_": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "description": "数据项列表",
            "items": { "$ref": "#/components/schemas/RunnerResponse" },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "description": "当前页码",
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "description": "每页条数",
            "title": "Page Size",
            "type": "integer"
          },
          "total": {
            "description": "总记录数",
            "title": "Total",
            "type": "integer"
          },
          "total_pages": {
            "description": "总页数",
            "title": "Total Pages",
            "type": "integer"
          }
        },
        "required": ["items", "total", "page", "page_size", "total_pages"],
        "title": "ListData[RunnerResponse]",
        "type": "object"
      },
      "ListResponse_ProjectResponse_": {
        "additionalProperties": false,
        "properties": {
          "data": { "$ref": "#/components/schemas/ListData_ProjectResponse_" },
          "success": { "const": true, "title": "Success", "type": "boolean" }
        },
        "required": ["success", "data"],
        "title": "ListResponse[ProjectResponse]",
        "type": "object"
      },
      "ListResponse_RunnerResponse_": {
        "additionalProperties": false,
        "properties": {
          "data": { "$ref": "#/components/schemas/ListData_RunnerResponse_" },
          "success": { "const": true, "title": "Success", "type": "boolean" }
        },
        "required": ["success", "data"],
        "title": "ListResponse[RunnerResponse]",
        "type": "object"
      },
      "ModuleOptionResponse": {
        "additionalProperties": false,
        "description": "权限编辑器中的模块完整摘要。",
        "properties": {
          "can_read": { "title": "Can Read", "type": "boolean" },
          "can_write": { "title": "Can Write", "type": "boolean" },
          "created_at": { "title": "Created At", "type": "string" },
          "description": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Description"
          },
          "display_name": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Display Name"
          },
          "effective_permission": {
            "anyOf": [
              { "enum": ["READ", "WRITE"], "type": "string" },
              { "type": "null" }
            ],
            "title": "Effective Permission"
          },
          "id": { "title": "Id", "type": "string" },
          "is_project_docs": { "title": "Is Project Docs", "type": "boolean" },
          "name": { "title": "Name", "type": "string" },
          "path": { "title": "Path", "type": "string" },
          "permission": {
            "anyOf": [
              { "enum": ["READ", "WRITE"], "type": "string" },
              { "type": "null" }
            ],
            "title": "Permission"
          },
          "project_id": { "title": "Project Id", "type": "string" },
          "role": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Role"
          },
          "updated_at": { "title": "Updated At", "type": "string" }
        },
        "required": [
          "id",
          "project_id",
          "name",
          "display_name",
          "description",
          "path",
          "is_project_docs",
          "permission",
          "effective_permission",
          "can_read",
          "can_write",
          "role",
          "created_at",
          "updated_at"
        ],
        "title": "ModuleOptionResponse",
        "type": "object"
      },
      "ModuleOptionsResponse": {
        "additionalProperties": false,
        "description": "有硬上限的模块选项响应。",
        "properties": {
          "hard_cap": { "title": "Hard Cap", "type": "integer" },
          "items": {
            "items": { "$ref": "#/components/schemas/ModuleOptionResponse" },
            "title": "Items",
            "type": "array"
          },
          "permission_generation": {
            "title": "Permission Generation",
            "type": "integer"
          },
          "total": { "title": "Total", "type": "integer" },
          "truncated": { "title": "Truncated", "type": "boolean" }
        },
        "required": [
          "items",
          "total",
          "truncated",
          "hard_cap",
          "permission_generation"
        ],
        "title": "ModuleOptionsResponse",
        "type": "object"
      },
      "ModuleScopeOptionsRequest": {
        "additionalProperties": false,
        "description": "Token scope 项目内模块 options 请求。",
        "properties": {
          "project_id": {
            "description": "项目 ID",
            "title": "Project Id",
            "type": "string"
          }
        },
        "required": ["project_id"],
        "title": "ModuleScopeOptionsRequest",
        "type": "object"
      },
      "ProjectListRequest": {
        "additionalProperties": false,
        "description": "获取项目列表请求",
        "properties": {
          "page": {
            "default": 1,
            "description": "页码，从1开始",
            "minimum": 1,
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "default": 20,
            "description": "每页条数，最小1，最大100",
            "maximum": 100,
            "minimum": 1,
            "title": "Page Size",
            "type": "integer"
          },
          "search": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "description": "搜索关键词（匹配名称或路径）",
            "title": "Search"
          },
          "sort_by": {
            "anyOf": [
              {
                "enum": ["name", "display_name", "created_at", "updated_at"],
                "type": "string"
              },
              { "type": "null" }
            ],
            "description": "排序字段",
            "title": "Sort By"
          },
          "sort_order": {
            "default": "desc",
            "description": "排序方向: asc/desc",
            "enum": ["asc", "desc"],
            "title": "Sort Order",
            "type": "string"
          }
        },
        "title": "ProjectListRequest",
        "type": "object"
      },
      "ProjectResponse": {
        "additionalProperties": false,
        "description": "项目响应",
        "properties": {
          "created_at": {
            "description": "创建时间",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "description": "项目描述",
            "title": "Description"
          },
          "display_name": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "description": "项目展示名称",
            "title": "Display Name"
          },
          "id": { "description": "项目 ID", "title": "Id", "type": "string" },
          "model_scope": {
            "default": "PUBLIC",
            "description": "项目允许使用的模型范围",
            "enum": ["PUBLIC", "INTERNAL"],
