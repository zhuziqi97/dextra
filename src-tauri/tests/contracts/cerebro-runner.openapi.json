              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Refresh Runner Token",
        "tags": ["Dextra执行端"]
      }
    },
    "/api/v1/execution-runners/list": {
      "post": {
        "description": "只列出当前用户自己的 Dextra。",
        "operationId": "list_execution_runners_api_v1_execution_runners_list_post",
