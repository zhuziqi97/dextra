  "paths": {
    "/api/v1/execution-runner-pairings/approve": {
      "post": {
        "description": "由当前登录用户批准自己的 Dextra。",
        "operationId": "approve_runner_pairing_api_v1_execution_runner_pairings_approve_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunnerPairingApproveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_RunnerPairingApproveResponse_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [{ "HTTPBearer": [] }],
        "summary": "Approve Runner Pairing",
        "tags": ["Dextra执行端"]
      }
    },
    "/api/v1/execution-runner-pairings/create": {
      "post": {
        "description": "为尚未登录的 Dextra 创建设备配对流程。",
        "operationId": "create_runner_pairing_api_v1_execution_runner_pairings_create_post",
        "requestBody": {
          "content": {
            "application/json": {
