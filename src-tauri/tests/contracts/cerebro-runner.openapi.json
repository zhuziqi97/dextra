  "paths": {
    "/api/v1/execution-runner-configurations/credential": {
      "post": {
        "description": "客户端自动使用、查看或重新生成当前目录凭证。",
        "operationId": "runner_configuration_credential_api_v1_execution_runner_configurations_credential_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientCredentialRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_ClientCredentialResponse_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Runner Configuration Credential",
        "tags": ["Dextra执行端"]
      }
    },
