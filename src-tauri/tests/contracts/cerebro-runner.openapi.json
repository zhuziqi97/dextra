        "properties": {
          "data": {
            "$ref": "#/components/schemas/RunnerPairingExchangeResponse"
          },
          "success": { "const": true, "title": "Success", "type": "boolean" }
        },
        "required": ["success", "data"],
        "title": "SuccessResponse[RunnerPairingExchangeResponse]",
        "type": "object"
      },
      "SuccessResponse_RunnerResponse_": {
        "additionalProperties": false,
        "properties": {
          "data": { "$ref": "#/components/schemas/RunnerResponse" },
          "success": { "const": true, "title": "Success", "type": "boolean" }
