            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [{ "HTTPBearer": [] }],
        "summary": "List Execution Runners",
        "tags": ["Dextra执行端"]
      }
    },
    "/api/v1/execution-runners/revoke": {
      "post": {
        "description": "撤销当前用户自己的 Dextra。",
        "operationId": "revoke_execution_runner_api_v1_execution_runners_revoke_post",
        "requestBody": {
          "content": {
            "application/json": {
