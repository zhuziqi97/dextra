  "messages": {
    "RunnerAuthenticateFrame": {
      "additionalProperties": false,
      "description": "WebSocket 建连后的首帧短期身份。",
      "properties": {
        "TOKEN": { "minLength": 1, "title": "Token", "type": "string" },
        "TYPE": { "const": "AUTHENTICATE", "title": "Type", "type": "string" }
      },
      "required": ["TYPE", "TOKEN"],
      "title": "RunnerAuthenticateFrame",
      "type": "object"
    },
    "RunnerHeartbeatEnvelope": {
      "additionalProperties": false,
      "description": "当前连接持有者发送的保活消息。",
      "properties": {
        "MESSAGE_ID": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "OCCURRED_AT": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "PAYLOAD": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "PROTOCOL_VERSION": {
          "const": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "RUNNER_ID": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Runner Id",
          "type": "string"
        },
        "TYPE": { "const": "HEARTBEAT", "title": "Type", "type": "string" }
      },
      "required": [
        "PROTOCOL_VERSION",
        "TYPE",
        "MESSAGE_ID",
        "OCCURRED_AT",
        "PAYLOAD",
        "RUNNER_ID"
      ],
      "title": "RunnerHeartbeatEnvelope",
      "type": "object"
    },
    "RunnerHelloEnvelope": {
      "$defs": {
        "RunnerHelloPayload": {
          "additionalProperties": false,
          "description": "Dextra 与固定 Codeg 边界的构建信息。",
          "properties": {
            "CODEG_API_REVISION": {
              "minimum": 1,
              "title": "Codeg Api Revision",
              "type": "integer"
            },
            "CODEG_UPSTREAM_COMMIT": {
              "maxLength": 64,
              "minLength": 1,
              "title": "Codeg Upstream Commit",
              "type": "string"
            },
            "CODEG_UPSTREAM_VERSION": {
              "maxLength": 64,
              "minLength": 1,
              "title": "Codeg Upstream Version",
              "type": "string"
            },
            "RUNNER_BUILD_ID": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Runner Build Id",
              "type": "string"
            }
          },
          "required": [
            "RUNNER_BUILD_ID",
            "CODEG_API_REVISION",
            "CODEG_UPSTREAM_VERSION",
            "CODEG_UPSTREAM_COMMIT"
          ],
          "title": "RunnerHelloPayload",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "Runner 认证后发送的首个协议消息。",
      "properties": {
        "MESSAGE_ID": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "OCCURRED_AT": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "PAYLOAD": { "$ref": "#/$defs/RunnerHelloPayload" },
        "PROTOCOL_VERSION": {
          "const": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "RUNNER_ID": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Runner Id",
          "type": "string"
        },
        "TYPE": { "const": "HELLO", "title": "Type", "type": "string" }
      },
      "required": [
        "PROTOCOL_VERSION",
        "TYPE",
        "MESSAGE_ID",
        "OCCURRED_AT",
        "PAYLOAD",
        "RUNNER_ID"
      ],
      "title": "RunnerHelloEnvelope",
      "type": "object"
    },
    "RunnerServerEnvelope": {
      "additionalProperties": false,
      "description": "平台返回给 Runner 的连接控制消息。",
      "properties": {
        "MESSAGE_ID": { "title": "Message Id", "type": "string" },
        "OCCURRED_AT": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "PAYLOAD": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "PROTOCOL_VERSION": {
          "const": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "RUNNER_ID": { "title": "Runner Id", "type": "string" },
        "TYPE": {
          "enum": ["HELLO_ACK", "HEARTBEAT_ACK"],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "PROTOCOL_VERSION",
        "TYPE",
        "MESSAGE_ID",
        "OCCURRED_AT",
        "RUNNER_ID",
        "PAYLOAD"
      ],
      "title": "RunnerServerEnvelope",
      "type": "object"
    },
    "RunnerTargetsReportEnvelope": {
      "$defs": {
        "RunnerTargetProjection": {
          "additionalProperties": false,
          "description": "Dextra 从单个用户根 Folder 派生的非秘密投影。",
          "properties": {
            "AGENT_TYPE": {
              "anyOf": [
                { "maxLength": 64, "type": "string" },
                { "type": "null" }
              ],
              "title": "Agent Type"
            },
            "AVAILABILITY": {
              "enum": ["AVAILABLE", "UNAVAILABLE"],
              "title": "Availability",
              "type": "string"
            },
            "BACKGROUND_TASK_UNAVAILABLE_REASON": {
              "anyOf": [
                { "$ref": "#/$defs/RunnerTargetReason" },
                { "type": "null" }
              ]
            },
            "BRANCH": {
              "anyOf": [
                { "maxLength": 255, "type": "string" },
                { "type": "null" }
              ],
              "title": "Branch"
            },
            "DISPLAY_NAME": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Display Name",
              "type": "string"
            },
            "MODE_DISPLAY_NAME": {
              "anyOf": [
                { "maxLength": 128, "type": "string" },
                { "type": "null" }
              ],
              "title": "Mode Display Name"
            },
            "REPOSITORY": {
              "anyOf": [
                { "maxLength": 255, "type": "string" },
                { "type": "null" }
              ],
              "title": "Repository"
            },
            "SUPPORTS_BACKGROUND_TASK": {
              "title": "Supports Background Task",
              "type": "boolean"
            },
            "TARGET_ID": {
              "maxLength": 255,
              "minLength": 1,
              "title": "Target Id",
              "type": "string"
            },
            "UNAVAILABLE_REASON": {
              "anyOf": [
                { "$ref": "#/$defs/RunnerTargetReason" },
                { "type": "null" }
              ]
            },
            "UPDATED_AT": {
              "format": "date-time",
              "title": "Updated At",
              "type": "string"
            },
            "WORKSPACE_DISPLAY_NAME": {
              "maxLength": 255,
              "minLength": 1,
              "title": "Workspace Display Name",
              "type": "string"
            }
          },
          "required": [
            "TARGET_ID",
            "DISPLAY_NAME",
            "WORKSPACE_DISPLAY_NAME",
            "REPOSITORY",
            "BRANCH",
            "SUPPORTS_BACKGROUND_TASK",
            "BACKGROUND_TASK_UNAVAILABLE_REASON",
            "AVAILABILITY",
            "UNAVAILABLE_REASON",
            "AGENT_TYPE",
            "MODE_DISPLAY_NAME",
            "UPDATED_AT"
          ],
          "title": "RunnerTargetProjection",
          "type": "object"
        },
        "RunnerTargetReason": {
          "additionalProperties": false,
          "description": "Target 能力或可用性的真实原因。",
          "properties": {
            "CODE": {
              "maxLength": 64,
              "minLength": 1,
              "title": "Code",
              "type": "string"
            },
            "MESSAGE": {
              "maxLength": 512,
              "minLength": 1,
              "title": "Message",
              "type": "string"
            }
          },
          "required": ["CODE", "MESSAGE"],
          "title": "RunnerTargetReason",
          "type": "object"
        },
        "RunnerTargetsReportPayload": {
          "additionalProperties": false,
          "description": "一台 Runner 当前拥有的完整 Target 集合。",
          "properties": {
            "TARGETS": {
              "items": { "$ref": "#/$defs/RunnerTargetProjection" },
              "maxItems": 1000,
              "title": "Targets",
              "type": "array"
            }
          },
          "required": ["TARGETS"],
          "title": "RunnerTargetsReportPayload",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "Dextra 主动上报的完整 Target 投影。",
      "properties": {
        "MESSAGE_ID": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "OCCURRED_AT": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "PAYLOAD": { "$ref": "#/$defs/RunnerTargetsReportPayload" },
        "PROTOCOL_VERSION": {
          "const": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "RUNNER_ID": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Runner Id",
          "type": "string"
        },
        "TYPE": { "const": "TARGETS_REPORT", "title": "Type", "type": "string" }
      },
      "required": [
        "PROTOCOL_VERSION",
        "TYPE",
        "MESSAGE_ID",
        "OCCURRED_AT",
        "PAYLOAD",
        "RUNNER_ID"
      ],
      "title": "RunnerTargetsReportEnvelope",
      "type": "object"
    }
  },
  "schema_version": 1
}
